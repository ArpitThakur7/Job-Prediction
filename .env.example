# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Groq API key for LLM
GROQ_API_KEY=your_groq_api_key_here

# Pinecone API key for vector database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=job-ai-index
PINECONE_ENV=us-east-1

# MongoDB connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=job_ai_db

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Application settings
SECRET_KEY=your_secret_key_here
DEBUG=True
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# SALVO ENGINE SETTINGS (Zero-Auth Discovery & Human-In-The-Loop Apply)
# ==============================================================================
SALVO_ENGINE_PORT=4173
SALVO_ENGINE_URL=http://127.0.0.1:4173

# --- Identity (used by Playwright form pre-filler) ---
APPLICANT_NAME="Your Name"
APPLICANT_EMAIL="your.email@example.com"
APPLICANT_PHONE="+1-555-0100"
APPLICANT_LOCATION="City, Country"
APPLICANT_GITHUB="https://github.com/yourusername"
APPLICANT_LINKEDIN="https://linkedin.com/in/yourusername"
APPLICANT_PORTFOLIO="https://yourportfolio.com"

# --- Work Authorization (answers exact screening questions) ---
WORK_AUTH_US="no"
WORK_AUTH_EU="no"
WORK_AUTH_UK="no"
WORK_AUTH_INDIA="yes"
REQUIRES_SPONSORSHIP="no"

# --- LLM for Truth-Bounded Resume Tailoring ---
# Optional: Leave blank and use Manual Mode (zero cost prompt copy/paste).
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-haiku-4-5"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Force provider: "claude" or "gemini" (leave blank to auto-detect from keys)
TAILOR_PROVIDER=""
